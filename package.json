{
  "name": "the-black-bird",
  "version": "6.0.0-candidate.0",
  "private": true,
  "description": "Validation harness for The Black Bird public source archive",
  "scripts": {
    "baseline:capture": "node tests/capture-canonical-baseline.cjs",
    "build": "node scripts/build.mjs",
    "build:verify": "node scripts/verify-build.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:legacy": "node tests/no-active-legacy.cjs",
    "test:traceability": "node tests/traceability-contract.cjs",
    "test:data": "node tests/black-bird-data-integrity.cjs",
    "test:baseline": "playwright test tests/black-bird-baseline.spec.js",
    "test:route-solo": "playwright test tests/black-bird-route-solo.spec.js",
    "test:world-camera": "playwright test tests/black-bird-world-camera.spec.js",
    "test:accessibility": "playwright test tests/black-bird-accessibility.spec.js",
    "test:mobile": "playwright test tests/black-bird-mobile.spec.js",
    "test:design": "playwright test tests/black-bird-design.spec.js",
    "test:visual": "playwright test tests/black-bird-evidence.spec.js",
    "test:full": "npm run test:legacy && npm run test:traceability && npm run test:data && npm run test:baseline && npm run test:route-solo && npm run test:world-camera && npm run test:accessibility && npm run test:mobile && npm run test:design && npm run test:visual && npm run test:docs",
    "test:docs": "node tests/documentation-contract.cjs",
    "test:coverage": "node scripts/generate-coverage.mjs",
    "test:e2e": "playwright test tests/e2e tests/generated --project=chromium",
    "test:a11y": "playwright test tests/a11y --project=chromium",
    "test:cross-browser": "playwright test tests/cross-browser --project=chromium --project=firefox --project=webkit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.62.0"
  }
}
